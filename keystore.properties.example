# Copy to keystore.properties (gitignored) and fill in the passwords.
#
# The keystore must live OUTSIDE this repo -- keystore.properties holds only a
# path to it. Back the .jks up somewhere off the phone: lose it and you can
# never ship an update under the same identity again.
#
# storeFile may be absolute or relative to the repo root.
storeFile=/data/data/com.termux/files/home/daisy.jks
storePassword=CHANGEME
keyAlias=daisy
keyPassword=CHANGEME
