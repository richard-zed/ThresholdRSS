lib/
out/
# Ignore local jars (lib/) but never the Gradle wrapper jar -- CI needs it.
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Gradle
.gradle/
build/
local.properties

# R8 output. `mapping.txt` is what deobfuscates a release stack trace, so it
# must be KEPT as a build artifact (Play accepts it for upload) but never
# committed -- it is regenerated per build and goes stale immediately.
app/build/
*.hprof

# Release signing credentials. The keystore itself lives outside the repo;
# this file holds only the path to it plus the passwords.
keystore.properties
*.jks
*.keystore
