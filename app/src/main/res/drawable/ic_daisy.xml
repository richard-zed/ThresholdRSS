<?xml version="1.0" encoding="utf-8"?>
<!--
    The Daisy mark, drawn to fill its viewport. This is the copy used inline
    (favicon slot, error painter), where it sits beside real favicons and must
    occupy the same box as one.

    The launcher uses ic_daisy_launcher instead, which scales the same art into
    the adaptive-icon safe zone. Keeping the two apart is deliberate: one fills
    its box, the other must not.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Badge: r=50 at (60,60). -->
    <path android:pathData="M60,10 a50,50 0 1,0 0.01,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="60"
                android:startY="110"
                android:endX="60"
                android:endY="10">
                <item android:offset="0" android:color="#0D7945" />
                <item android:offset="0.3763" android:color="#14B667" />
                <item android:offset="1" android:color="#17ACAE" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="butt"
        android:fillColor="#00000000"
        android:pathData="M 30,35 A 55,55 0 0 1 85,90" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="butt"
        android:fillColor="#00000000"
        android:pathData="M 30,55 A 35,35 0 0 1 65,90" />

    <path
        android:fillColor="#E8E833"
        android:pathData="M39,72 a9,9 0 1,0 0.01,0 z" />
</vector>
