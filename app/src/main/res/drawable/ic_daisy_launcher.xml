<?xml version="1.0" encoding="utf-8"?>
<!--
    The Daisy mark as an adaptive-icon foreground: the same art scaled 0.6 and
    offset 18 so it sits inside the middle 72dp of the 108dp canvas, clear of
    every launcher mask.

    Drawn without a background layer of its own. The earlier version put a
    solid green behind the badge, but the badge is only 60dp across inside a
    72dp safe zone, so the two greens met as a visible ring at the rim.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="18"
        android:translateY="18"
        android:scaleX="0.6"
        android:scaleY="0.6">

        <path android:pathData="M60,10 a50,50 0 1,0 0.01,0 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="60"
                    android:startY="110"
                    android:endX="60"
                    android:endY="10">
                    <item android:offset="0" android:color="#0D7945" />
                    <item android:offset="0.3763" android:color="#14B667" />
                    <item android:offset="1" android:color="#17ACAE" />
                </gradient>
            </aapt:attr>
        </path>

        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="10"
            android:strokeLineCap="butt"
            android:fillColor="#00000000"
            android:pathData="M 30,35 A 55,55 0 0 1 85,90" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="10"
            android:strokeLineCap="butt"
            android:fillColor="#00000000"
            android:pathData="M 30,55 A 35,35 0 0 1 65,90" />

        <path
            android:fillColor="#E8E833"
            android:pathData="M39,72 a9,9 0 1,0 0.01,0 z" />
    </group>
</vector>
