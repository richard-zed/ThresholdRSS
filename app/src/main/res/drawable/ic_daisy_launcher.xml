<?xml version="1.0" encoding="utf-8"?>
<!--
    Foreground only, no <background> layer: the badge reaches the canvas edge
    on every axis, so the mask cuts inside it and there is nothing behind to
    show as a ring.

    Transcribed from daisy.svg at 108x108. The gradient carries a
    gradientTransform of matrix(1.08,0,0,1.08,-10.8,-10.8), which resolves its
    y1=110/y2=10 onto user-space y=108/y=0; the stops below use those resolved
    coordinates, so the ramp spans the full badge height.

    Both arcs are stroked with linecap round, matching the SVG.
    Scaled 0.667 into the 72dp safe zone, offset 18.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="18"
        android:translateY="18"
        android:scaleX="0.6666667"
        android:scaleY="0.6666667">

        <!-- Badge: r=54 at (54,54). -->
        <path android:pathData="M54,0 a54,54 0 1,0 0.01,0 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="108"
                    android:endX="54"
                    android:endY="0">
                    <item android:offset="0" android:color="#0D7945" />
                    <item android:offset="0.3763" android:color="#14B667" />
                    <item android:offset="1" android:color="#17ACAE" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Outer quarter ring: radius 53.3415, stroke 10.6584, round cap. -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="10.6584"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M 27.329201,27.329201 A 53.341534,53.341599 0 0 1 80.670734,80.670799" />

        <!-- Inner quarter ring: radius 33.3943, stroke 10.6056, round cap. -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="10.6056"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M 27.302799,47.302799 A 33.394344,33.39439 0 0 1 60.697144,80.697189" />

        <!-- Yellow dot: r=11 at (33, 75). -->
        <path
            android:fillColor="#E8E833"
            android:pathData="M33,64 a11,11 0 1,0 0.01,0 z" />
    </group>
</vector>
