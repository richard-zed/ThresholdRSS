<?xml version="1.0" encoding="utf-8"?>
<!--
    Foreground only, no <background> layer.

    The badge is r=54 on a 108 grid, so it reaches the canvas edge on every
    axis. Inside the 72dp safe zone that means the mask cuts inside the badge
    rather than outside it, and there is no background colour anywhere to show
    as a ring. An earlier version drew a flat green behind the badge and the
    two greens met as a visible annulus; dropping the layer removes the
    possibility rather than matching the colour and hoping.

    54 -> 36 is 0.667 scale, offset (54-36) = 18 to centre the 72dp box.

    Geometry below is transcribed from daisy.svg at 108x108, unmodified,
    including the arc anchors at (21.6, 86.4).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="18"
        android:translateY="18"
        android:scaleX="0.6666667"
        android:scaleY="0.6666667">

        <!-- Badge: r=54 at (54,54). -->
        <path android:pathData="M54,0 a54,54 0 1,0 0.01,0 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="99"
                    android:endX="54"
                    android:endY="9">
                    <item android:offset="0" android:color="#0D7945" />
                    <item android:offset="0.3763" android:color="#14B667" />
                    <item android:offset="1" android:color="#17ACAE" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Outer quarter ring: stroke 10.8. -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="10.8"
            android:strokeLineCap="butt"
            android:fillColor="#00000000"
            android:pathData="M 21.6,27 A 59.4,59.4 0 0 1 81,86.4" />

        <!-- Inner quarter ring: stroke 10.8. -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="10.8"
            android:strokeLineCap="butt"
            android:fillColor="#00000000"
            android:pathData="m 21.6,48.6 a 37.8,37.8 0 0 1 37.8,37.8" />

        <!-- Yellow dot: r=9.72 at (31.32, 76.68). -->
        <path
            android:fillColor="#E8E833"
            android:pathData="M31.32,66.96 a9.72,9.72 0 1,0 0.01,0 z" />
    </group>
</vector>
